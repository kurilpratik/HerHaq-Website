---
import MainLayout from "../layouts/MainLayout.astro";
import { researchData } from "../data/researchData.js";
---
<MainLayout
  title="Research"
  description="Research to inform laws, platforms, and governance that better serve women and marginalised communities."
>
  <!-- Research Header Section -->
  <section class="header-section">
    <div class="container">
      <div class="header-content">
        <div class="header-text">
          <h1 class="header-title">RESEARCH</h1>
          <p class="header-description">
            Her Haq conducts research to inform laws, platforms, and governance
            that better serve women and marginalised communities. We believe
            knowledge should be a public good, and we share our insights openly
            to empower advocates, policymakers, and citizens alike.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Display Section -->
  <section class="research-display-section">
    <div class="container">

      <!-- Research Grid -->
      <div class="research-grid">
        {
          researchData.map((research) => (
            <a
              class="research-card"
              href={research.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="card-image">
                <img src={research.img} alt={research.title} />
              </div>
              <div class="card-body">
                <span class="card-badge">
                  {research.category === "report" ? "Report" : "Policy Brief"}
                </span>
                <h4 class="card-title">{research.title}</h4>
              </div>
            </a>
          ))
        }
      </div>

    </div>
  </section>
</MainLayout>

<style lang="scss">
  @import "../styles/styles.scss";

  .header-section {
    background: $primary;
    padding: 7rem 0;
    color: #fff;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    @include mobile {
      flex-direction: column;
      text-align: center;
    }
  }

  .header-text {
    flex: 1;
  }

  .header-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .header-description {
    font-size: 1.2rem;
    line-height: 1.7;
  }

  // Research Display Section
  .research-display-section {
    padding: 3rem 0;
    background: #fff;
  }

  // Grid Layout
  .research-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;

    @media (max-width: 900px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include mobile {
      grid-template-columns: 1fr;
    }
  }

  // Card
  .research-card {
    background: #fdf0f0;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    transition: all 0.25s ease;
    border: 2px solid transparent;
    text-decoration: none;
    display: block;

    &:hover {
      background: $primary;
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);

      .card-title {
        color: #fff;
      }

      .card-badge {
        background: rgba(255, 255, 255, 0.25);
        color: #fff;
      }
    }
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .card-body {
    padding: 1rem;
  }

  .card-badge {
    display: inline-block;
    background: $primary;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 4px;
    margin-bottom: 0.6rem;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #222;
    margin: 0;
    line-height: 1.4;
    transition: color 0.25s ease;
  }
</style>