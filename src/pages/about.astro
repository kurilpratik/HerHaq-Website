---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";
import { howWeWorkSteps } from "../data/howWeWorkSteps.js";
import teamData from "../data/teamData";
---

<MainLayout title="About" description="About Her Haq">
  <!-- About Us Section -->
  <section class="about-section">
    <div class="container">
      <div class="about-content">
        <div class="about-text">
          <h1 class="about-title">ABOUT US</h1>
          <p class="about-description">
            What started as a student-led initiative has evolved into a
            youth-powered nonprofit operating across multiple states, leading
            community-driven programs that advance <strong
              >women's rights, public dialogue, and grassroots research</strong
            >. We centre lived experience, shift power, and build structures
            that last.
            <!-- We center lived experience, shift power, and build structures that last. -->
          </p>
        </div>
        <div class="about-image">
          <img
            src="https://res.cloudinary.com/dbjdfox1r/image/upload/f_auto,q_auto/v1763670968/About_Us-min_b1o5q5.png"
            alt="About Her Haq"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Are Section -->
  <section class="who-we-are-section">
    <div class="who-we-are-container">
      <div class="who-we-are-gallery" aria-label="Her Haq community work">
        <div class="who-we-are-gallery-top">
          <img src="https://res.cloudinary.com/q9ivm4og/image/upload/v1793250679/1.jpg" alt="Her Haq team members sharing menstrual health information" loading="lazy" />
          <img src="https://res.cloudinary.com/q9ivm4og/image/upload/v1793250691/2.jpg" alt="Her Haq community members taking part in a discussion" loading="lazy" />
        </div>
        <img class="who-we-are-gallery-wide" src="https://res.cloudinary.com/q9ivm4og/image/upload/v1793250751/3.jpg" alt="Participants gathered at a Her Haq Charcha event" loading="lazy" />
      </div>
      <div class="who-we-are-text">
        <h2 class="who-we-are-title">WHO WE ARE</h2>
        <div class="who-we-are-description">
          <p>Her Haq was born from a sense of discontent and hope. Discontent with the way policy conversations too often exclude the people most affected. And hope that there could be a better way, one that starts with listening, not prescribing. What began as a small student-led initiative quickly grew into a youth-powered nonprofit with a clear mission: to centre the voices of women and girls in shaping the systems that impact their lives. From the very beginning, our work has been grounded in one simple belief—those closest to the problem should lead the way in solving it.</p>
          <p>At Her Haq, we work at the intersection of grassroots lived experience and systemic change. We research, convene, and co-create solutions with communities who are too often spoken for instead of spoken with. Our projects span digital safety workshops, community-led research, legal advocacy, and public convenings like Haq Summit and Charcha, which bring together experts, policymakers, and citizens in collective dialogue. We aim to be positively disruptive, pushing back against outdated systems while working constructively with decision-makers to close the gaps that perpetuate inequality. Our goal isn't just to critique what exists, but to help build what's missing: inclusive, accountable, and feminist structures that respond to the real needs of real people.</p>
          <p>We are not here to lead from above but to work alongside stakeholders. Her Haq is a bridge between communities and institutions, between everyday realities and systemic reform. And we are just getting started.</p>
        </div>
      </div>
    </div>
  </section>  
  
  <!-- Our Interventions Section -->
  <section class="interventions-section">
    <div class="interventions-container">
      <h2 class="interventions-title">OUR INTERVENTIONS</h2>
      <div class="interventions-grid">
        <a class="intervention-card" href="/fieldwork" aria-label="MHM Drives">
          <img src="https://res.cloudinary.com/dbjdfox1r/image/upload/f_auto,q_auto:low/v1763670966/MHM-min_zofq71.png" alt="Her Haq MHM drive" loading="lazy" />
          <span>MENSTRUAL HYGIENE MANAGEMENT DRIVES</span>
        </a>
        <a class="intervention-card" href="https://www.instagram.com/herhaqofficial/" target="_blank" rel="noopener noreferrer" aria-label="Digital Advocacy">
          <img src="https://res.cloudinary.com/dbjdfox1r/image/upload/f_auto,q_auto:low/v1763670967/Digital_Advocacy-min_wvmvzg.png" alt="Her Haq digital advocacy discussion" loading="lazy" />
          <span>DIGITAL ADVOCACY</span>
        </a>
        <a class="intervention-card" href="/research" aria-label="Research and Policy">
          <img src="https://res.cloudinary.com/dbjdfox1r/image/upload/f_auto,q_auto:low/v1763670966/Policy-min_skydff.png" alt="Her Haq research and policy materials" loading="lazy" />
          <span>RESEARCH &amp; POLICY</span>
        </a>
        <a class="intervention-card" href="/events" aria-label="Charcha">
          <img src="https://res.cloudinary.com/dbjdfox1r/image/upload/f_auto,q_auto:low/v1763670976/Charcha-min_r7faul.png" alt="Audience at a Her Haq Charcha event" loading="lazy" />
          <span>CHARCHA</span>
        </a>
      </div>
    </div>
  </section>

   <!-- Team Section -->
  <section class="team-section">
    <div class="container">
      <!-- Trustees Section -->
      <div class="team-category">
        <h2 class="team-category-title">TRUSTEES</h2>
        <div class="team-grid">
          {
            teamData.trustees.map((member) => (
              <div class="team-member">
                <a class="team-member-image-wrapper team-member-image-link" href={member.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${member.name}'s LinkedIn profile`}>
                  <img
                    src={member.imageUrl}
                    alt={member.name}
                    class="team-member-image"
                    loading="lazy"
                  />
                  <span class="team-member-image-link-overlay" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 8A6 6 0 0 1 22 14V21H18V14A2 2 0 0 0 14 14V21H10V14A6 6 0 0 1 16 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <rect x="2" y="9" width="4" height="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></rect>
                      <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></circle>
                    </svg>
                  </span>
                </a>
                <div class="team-member-meta">
                  <h3 class="team-member-name"><a href={member.linkedinUrl} target="_blank" rel="noopener noreferrer">{member.name}</a></h3>
                </div>
                <p class="team-member-title">{member.title}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Core Team Section -->
      <div class="team-category">
        <h2 class="team-category-title">CORE TEAM</h2>
        <div class="team-grid">
          {
            teamData.coreTeam.map((member) => (
              <div class="team-member">
                <a class="team-member-image-wrapper team-member-image-link" href={member.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${member.name}'s LinkedIn profile`}>
                  <img
                    src={member.imageUrl}
                    alt={member.name}
                    class="team-member-image"
                    loading="lazy"
                  />
                  <span class="team-member-image-link-overlay" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 8A6 6 0 0 1 22 14V21H18V14A2 2 0 0 0 14 14V21H10V14A6 6 0 0 1 16 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      <rect x="2" y="9" width="4" height="12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></rect>
                      <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></circle>
                    </svg>
                  </span>
                </a>
                <div class="team-member-meta">
                  <h3 class="team-member-name"><a href={member.linkedinUrl} target="_blank" rel="noopener noreferrer">{member.name}</a></h3>
                </div>
                <p class="team-member-title">{member.title}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- How We Work Section -->
  <section class="how-we-work-section">
    <div class="container">
      <div class="how-we-work-content">
        <div class="how-we-work-header">
          <h2 class="how-we-work-title">HOW WE WORK</h2>
          <p class="how-we-work-intro">
            At Her Haq, we don't drop in with solutions, we build alongside. Our
            process is iterative, grounded, and deeply human.
          </p>
        </div>

        <div class="how-we-work-steps">
          {
            howWeWorkSteps.map((step) => (
              <div class="step">
                <div class="step-number">
                  <span class="step-icon">{step.number}</span>
                </div>
                <div class="step-content">
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-description">{step.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- SDGs Section -->
  <section class="sdgs-section">
    <div class="container">
      <div class="sdgs-content">
        <img src="/logos/SDGLogo.png" alt="SDG Logo" class="sdg-logo" />
        <div class="sdgs-grid">
          <div class="sdg-item">
            <img src="/sdgs/3.png" alt="SDG 3: Good Health and Well-being" />
            <!-- <h4>GOOD HEALTH AND WELL-BEING</h4> -->
          </div>
          <div class="sdg-item">
            <img src="/sdgs/4.png" alt="SDG 4: Quality Education" />
            <!-- <h4>QUALITY EDUCATION</h4> -->
          </div>
          <div class="sdg-item">
            <img src="/sdgs/5.png" alt="SDG 5: Gender Equality" />
            <!-- <h4>GENDER EQUALITY</h4> -->
          </div>
          <div class="sdg-item">
            <img src="/sdgs/10.webp" alt="SDG 10: Reduced Inequalities" />
            <!-- <h4>REDUCED INEQUALITIES</h4> -->
          </div>
          <div class="sdg-item">
            <img
              src="/sdgs/16.png"
              alt="SDG 16: Peace, Justice and Strong Institutions"
            />
            <!-- <h4>PEACE, JUSTICE AND STRONG INSTITUTIONS</h4> -->
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style lang="scss">
  @import "../styles/styles.scss";
  .about-section {
    background: $primary;
    padding: 5rem 0;
    color: #fff;
  }

  .about-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    @include mobile {
      flex-direction: column;
      text-align: center;
    }
  }

  .about-text {
    flex: 1;
  }

  .about-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .about-description {
    font-size: 1.2rem;
    line-height: 1.7;
    em {
      font-style: italic;
      font-weight: 600;
    }
    strong {
      font-weight: 700;
    }
  }

  .about-image {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .about-image img {
    width: 100%;
    height: 70%;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    background: #eee;

    @include mobile {
      max-width: 100%;
      width: 100%;
    }
  }

  // Who We Are Section and our intervention Styles
 .who-we-are-section { 
    background: #fff; 
    padding-block: clamp(2rem, 4vw, 3.5rem);
    color: #333; 
  }
  .who-we-are-container { 
    width: min(92%, 1180px);
    margin: 0 auto; 
    display: grid; 
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.1fr); 
    align-items: start; 
    gap: clamp(2rem, 4vw, 4rem); 
  }


  .who-we-are-gallery { 
    display: grid; 
    gap: 1rem; 
    min-width: 0; 
  }


  .who-we-are-gallery-top { 
    display: grid; 
    grid-template-columns: repeat(2, minmax(0, 1fr)); 
    gap: 1rem; 
  }
  .who-we-are-gallery-top img { 
    display: block; 
    width: 100%; 
    aspect-ratio: 4 / 5; 
    object-fit: cover; 
  }


  .who-we-are-gallery-wide { 
    display: block; 
    width: 100%; 
    aspect-ratio: 16 / 9; 
    object-fit: cover; 
  }
  .who-we-are-text { 
    min-width: 0; 
  }
  .who-we-are-title {
     font-size: 2.5rem; 
     font-weight: 700; 
     color: #892d28; 
     margin: 0 0 1rem; 
     text-align: left; 
     line-height: 1; 
    }
  .who-we-are-description p { 
    font-size: 1rem; 
    line-height: 1.5; 
    margin: 0 0 1rem; 
    color: #222; 
    text-align: left; 
  }
  .who-we-are-description p:last-child { margin-bottom: 0; }
  .interventions-section { 
    background: #ffe5dc; 
    // padding: 1.75rem 0 2rem; 
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
  }
  .interventions-container { 
    width: min(92%, 1120px); 
    margin: 0 auto;
   }
  .interventions-title {
     margin: 0 0 1.5rem; 
     color: #892d28; 
     font-size: 2rem; 
     font-weight: 700; 
     line-height: 1.2; 
     text-align: center; 
    }
  .interventions-grid { 
    display: grid; 
    grid-template-columns: repeat(4, minmax(0, 1fr)); 
    gap: 1.25rem; 
  }


  .intervention-card { 
    min-width: 0; 
    min-height: 100%; 
    padding: 0.65rem; 
    border-radius: 14px; 
    background: #fff; 
    color: #892d28; 
    text-align: center; 
    text-decoration: none; 
    font-weight: 700; 
    text-transform: uppercase; 
    display: flex; 
    flex-direction: column; 
    align-items: stretch; 
    gap: 0.65rem; 
  }

  .intervention-card img { 
    display: block; 
    width: 100%; 
    aspect-ratio: 1.65 / 1; 
    object-fit: cover; 
  }

  .intervention-card span { 
    min-height: 2.5em; 
    display: flex; 
    align-items: center; 
    justify-content: center; 
  }

  .intervention-card:focus-visible { 
    outline: 3px solid #891d1a; 
    outline-offset: 4px; 
  }
  .intervention-card { 
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }
  .intervention-card:hover, .intervention-card:focus-visible { 
    background: #891d1a; 
    color: #fff; 
    transform: translateY(-3px); 
  }

  @media (max-width: 900px) {
    .who-we-are-container { 
      grid-template-columns: minmax(0, 1fr); 
    }
    .who-we-are-gallery { 
      max-width: 620px; 
      width: 100%; 
      margin-inline: auto; 
    }
    .interventions-grid { 
      grid-template-columns: repeat(2, minmax(0, 1fr)); 
      gap: 1.25rem; 
    }
  }
  @media (max-width: 600px) {
    .who-we-are-section { padding: 1.5rem 0; }
    .who-we-are-title { font-size: 2rem; }
    .interventions-title { font-size: 1.6rem; }
    .interventions-grid { 
      grid-template-columns: minmax(0, 1fr); 
      gap: 1rem; 
    }
    .intervention-card {
       font-size: 0.95rem; 
       max-width: 420px; 
       width: 100%; 
       margin-inline: auto; 
      }
  }

  // How We Work Section Styles
  .how-we-work-section {
    background: #ffffff;
    padding: 4rem 0;
    color: #333;
  }

  .how-we-work-content {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }

  .how-we-work-header {
    margin-bottom: 3rem;
    @include mobile {
      margin-bottom: 2rem;
    }
  }

  .how-we-work-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #892d28;
    margin-bottom: 1rem;
    @include mobile {
      font-size: 2rem;
    }
  }

  .how-we-work-intro {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #000;
    margin-bottom: 2rem;
    max-width: 60%;
    margin-inline: auto;
    @include mobile {
      font-size: 1rem;
      line-height: 1.6;
    }
  }

  .how-we-work-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    @include mobile {
      gap: 1.5rem;
    }
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    text-align: left;
    @include mobile {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  .step-number {
    width: 50px;
    height: 50px;
    background: #892d28;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.5rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .step-icon {
    font-size: 1.2rem;
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: #892d28;
    margin-bottom: 0.5rem;
    @include mobile {
      font-size: 1rem;
    }
  }

  .step-description {
    font-size: 1rem;
    line-height: 1.5;
    color: #666;
    @include mobile {
      font-size: 0.9rem;
      line-height: 1.4;
    }
  }

  /* SDGs Section Styles */
  .sdgs-section {
    background: #fff;
    padding: 3rem 0;
    text-align: center;
  }

  .sdgs-content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .sdg-logo {
    max-width: 400px;
    margin: 0.5rem auto 2rem;
    display: block;

    @include mobile {
      // max-width: 200px;
    }
  }

  .sdgs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 4px;
    justify-content: center;
    @include mobile {
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
  }

  .sdg-item {
    text-align: center;
    height: 200px;
    width: 200px;
    // padding: 1.5rem;
    background: #fff;
    // border-radius: 10px;
    // box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
    margin: 0 auto;

    // &:hover {
    //   transform: translateY(-5px);
    // }
  }

  .sdg-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .sdg-item h4 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
    margin-top: 0.5rem;
  }

  // Team Section Styles
  .team-section {
    padding: 2rem 0;
    background: white;

    @include mobile {
      padding: 3rem 0;
    }
  }

  .team-category {
    margin-bottom: 5rem;

    @include mobile {
      margin-bottom: 3rem;
    }
  }

  .team-category-title {
    text-align: center;
    font-weight: $font-weight-bold;
    font-size: 2.5rem;
    color: $primary;
    margin-bottom: 3rem;
    text-transform: uppercase;
    letter-spacing: 2px;

    @include mobile {
      font-size: 2rem;
      margin-bottom: 2rem;
    }
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    max-width: 800px;
    margin: 0 auto;

    @include mobile {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 400px;
    }
  }

  .team-member {
    text-align: center;
    transition: transform 0.3s ease;

    &:hover {
      transform: translateY(-5px);
    }
  }

  .team-member-image-wrapper {
    margin: 0 auto 1.5rem;
    aspect-ratio: 3 / 4; // pick the rectangle ratio you prefer
    width: 100%;
    max-width: 260px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
    border-radius: 0;
    transition: border-radius 180ms ease;

    @include mobile {
      max-width: 220px;
    }
  }

  .team-member-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

   .team-member-image-link-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 0 0.75rem;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.38);
    color: #fff;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  
  .team-member-image-link-overlay svg {
    width: 46px;
    height: 46px;
    padding: 9px;
    border-radius: 36%;
    background: $primary;
  }

   .team-member-image-link:hover .team-member-image-link-overlay,
  .team-member-image-link:focus-visible .team-member-image-link-overlay {
    opacity: 1;
  }

  .team-member-image-link:hover,
  .team-member-image-link:focus-visible {
    border-radius: 10px;
  }

  .team-member-image-link:focus-visible {
    outline: 3px solid $primary;
    outline-offset: 4px;
  }

    .team-member-meta { 
      width: 100%; 
      max-width: 260px; 
      margin: 0 auto 0.5rem; 
      text-align: center; 
    }

  .team-member-name a {
    color: $primary;
    text-decoration: none;
    transition: color 0.2s ease;
  }


  .team-member-name {
    font-weight: $font-weight-bold;
    font-size: 1.2rem;
    color: $primary;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;

    @include mobile {
      font-size: 1rem;
    }
  }

  .team-member-title {
    width: 100%;
    max-width: 260px;
    margin: 0 auto;
    text-align: center;
    font-weight: $font-weight-normal;
    font-size: 0.95rem;
    color: $primary;
    text-transform: uppercase;
    letter-spacing: 0.5px;

    @include mobile {
      font-size: 0.875rem;
    }
  }

   .team-member-name a {
    color: $primary;
    text-decoration: none;
    transition: color 0.2s ease;
    text-align: center;

    &:hover,
    &:focus-visible {
      text-decoration: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intervention-card,
    .team-member-image-link-overlay {
      transition: none;
    }
  }

</style>
