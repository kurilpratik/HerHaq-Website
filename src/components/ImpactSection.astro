<section class="impact-section" aria-labelledby="impact-title">
    <div class="impact-container">
        <h2 id="impact-title">Our impact at a glance</h2>

        <div class="impact-layout">
            <figure class="map">
                <img
                    class="india-map"
                    src="/map/country.png"
                    alt="Illustrative map of India"
                />
                <figcaption>
                    <span
                        >At Her Haq, we aren't just raising awareness. We're
                        shifting 
                    </span>
                    <span>
                        narratives, redistributing power, and building structures that last.
                    </span>
                </figcaption>
            </figure>
            <div class="impact-stats">
                <article class="impact-stat">
                    <p
                        class="impact-number"
                        data-target="50000"
                        data-suffix="+"
                    >
                        0+
                    </p>
                    <p class="impact-label">Pads donated</p>
                </article>
                <article class="impact-stat">
                    <p
                        class="impact-number"
                        data-target="10000"
                        data-suffix="+"
                    >
                        0+
                    </p>
                    <p class="impact-label">Lives impacted</p>
                </article>
                <article class="impact-stat">
                    <p class="impact-number" data-target="100" data-suffix="+">
                        0+
                    </p>
                    <p class="impact-label">Workshops conducted</p>
                </article>
            </div>
        </div>
    </div>
</section>

<style>
    .impact-section {
        padding: 4rem 1.25rem;
        background: #fff;
    }

    .impact-container {
        width: min(100%, 1120px);
        margin: 0 auto;
    }

    .impact-container h2 {
        margin: 0 0 2.5rem;
        color: #891d1a;
        font: inherit;
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 700;
        text-align: center;
        text-transform: uppercase;
    }

    .impact-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: center;
    }

    .map {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
    }

    .map img,
    .map svg {
        display: block;
        width: 100%;
        max-height: 380px;
        height: auto;
        object-fit: contain;
        overflow: visible;
    }

    .india-outline {
        fill: #fff;
        stroke: #891d1a;
        stroke-width: 3;
        stroke-linejoin: round;
    }

    .marker circle {
        fill: #891d1a;
        stroke: #fff;
        stroke-width: 2;
    }

    .marker rect {
        fill: #891d1a;
    }

    .marker text {
        fill: #fff;
        font-family: Poppins, sans-serif;
        font-size: 10px;
        font-weight: 500;
        text-anchor: middle;
    }

    .map figcaption {
        margin-top: 0.75rem;
        color: #891d1a;
        font-size: 0.875rem;
        text-align: center;
        line-height: 1.15;
        font-weight: 600;
    }

    .map figcaption span {
        display: block;
        white-space: nowrap;
    }

    .impact-stats {
        display: grid;
        width: min(100%, 440px);
        gap: 1.25rem;
        margin-inline: auto;
    }

    .impact-stat {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.4rem;
        padding: 1rem 1.25rem;
        border: 1px solid #891d1a;
        border-radius: 8px;
        background: #891d1a;
        text-align: center;
    }

    .impact-number {
        margin: 0;
        padding: 0;
        border-radius: 0;
        color: #fff;
        background: transparent;
        font-size: clamp(1.5rem, 2.9vw, 2.5rem);
        font-weight: 700;
        text-align: center;
        white-space: normal;
    }

    .impact-label {
        margin: 0;
        color: #fff;
        font-size: clamp(1rem, 2vw, 1.25rem);
        font-weight: 600;
        line-height: 1.4;
    }

    @media (max-width: 680px) {
        .impact-section {
            padding-block: 3rem;
        }

        .impact-layout {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .map {
            width: min(100%, 330px);
        }

        .impact-stats {
            width: min(80%, 300px);
            margin: 0 auto;
        }
    }

    @media (max-width: 420px) {
        .impact-number {
            font-size: 1.15rem;
        }
    }
</style>

<script>
    function animateNumber(
        element: HTMLElement,
        target: number,
        suffix: string,
        duration: number,
    ) {
        const startTime = performance.now();

        const updateNumber = (currentTime: number) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);

            const currentValue = Math.floor(target * progress);

            element.textContent = currentValue.toLocaleString() + suffix;

            if (progress < 1) {
                requestAnimationFrame(updateNumber);
            } else {
                element.textContent = target.toLocaleString() + suffix;
            }
        };

        requestAnimationFrame(updateNumber);
    }
    document.addEventListener("DOMContentLoaded", () => {
        const statNumbers = document.querySelectorAll(
            ".impact-number",
        ) as NodeListOf<HTMLElement>;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const target = entry.target as HTMLElement;

                        const targetValue = parseInt(
                            target.getAttribute("data-target") || "0",
                        );

                        const suffix = target.getAttribute("data-suffix") || "";

                        if (!target.classList.contains("animated")) {
                            target.classList.add("animated");

                            animateNumber(target, targetValue, suffix, 1500);
                        }

                        observer.unobserve(target);
                    }
                });
            },
            {
                threshold: 0.5,
            },
        );

        statNumbers.forEach((stat) => {
            observer.observe(stat);
        });
    });
</script>
