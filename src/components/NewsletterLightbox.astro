<dialog
  class="newsletter-lightbox"
  aria-labelledby="newsletter-title"
  aria-describedby="newsletter-description"
>
  <div class="lightbox-header">
    <button
      class="lightbox-close"
      type="button"
      aria-label="Close newsletter signup"
    >
      &times;
    </button>
    <h2 id="newsletter-title">EMPOWER COMMUNITIES</h2>
    <p id="newsletter-description">Help us bring education, health, and hope to those in need.</p>
  </div>

  <form class="newsletter-form">
    <div class="field-row">
      <label>
        First name <span aria-hidden="true">*</span>
        <input
          name="firstName"
          autocomplete="given-name"
          maxlength="100"
          required
        />
      </label>
      <label>
        Last name <span aria-hidden="true">*</span>
        <input
          name="lastName"
          autocomplete="family-name"
          maxlength="100"
          required
        />
      </label>
    </div>
    <label>
      Email <span aria-hidden="true">*</span>
      <input
        name="email"
        type="email"
        autocomplete="email"
        maxlength="254"
        required
      />
    </label>

    <label class="website-field" aria-hidden="true">
      Leave this field empty
      <input name="website" tabindex="-1" autocomplete="off" />
    </label>

    <p class="form-status" role="status" aria-live="polite"></p>
    <div class="form-actions">
      <button class="submit-button" type="submit">Sign me up</button>
      <button class="later-button" type="button">Maybe later</button>
    </div>
    <p class="privacy-note">
      We’ll use these details to share Her Haq updates. Read our
      <a href="/others/privacy" target="_blank" rel="noreferrer"
        >Privacy Policy</a
      >.
    </p>
  </form>
</dialog>

<style>
  .newsletter-lightbox {
    width: min(450px, calc(100vw - 32px));
    max-width: none;
    max-height: min(88dvh, 610px);
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: 14px;
    color: #252225;
    background: #fff;
    box-shadow: 0 18px 60px rgb(50 22 32 / 22%);
    font-family: inherit;
    position: fixed;
    inset: 0;
    margin: auto;
  }

  .newsletter-lightbox::backdrop {
    background: transparent;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .lightbox-header {
    position: relative;
    padding: 22px 28px 18px;
    color: #fff;
    text-align: center;
    /* background: linear-gradient(115deg, #a80b3f, #c83270); */
    background: #891d1a;
  }

  .lightbox-header .eyebrow {
    margin: 0 0 5px;
    color: #ffe4ed;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lightbox-header h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .lightbox-header > p:last-child {
    margin: 5px 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .lightbox-close {
    position: absolute;
    top: 9px;
    right: 10px;
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: rgb(255 255 255 / 18%);
    font: inherit;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .newsletter-form {
    display: grid;
    gap: 12px;
    padding: 20px 24px 18px;
  }

  .newsletter-form label {
    display: block;
    color: #373136;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .newsletter-form label span {
    color: #b20b45;
  }

  .newsletter-form input {
    display: block;
    width: 100%;
    height: 39px;
    margin-top: 5px;
    padding: 8px 10px;
    border: 1px solid #ded9db;
    border-radius: 6px;
    color: #252225;
    background: #fff;
    font: inherit;
    font-size: 0.84rem;
  }

  .newsletter-form input:focus {
    border-color: #a80b3f;
    outline: 2px solid rgb(168 11 63 / 15%);
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-status {
    min-height: 1.2em;
    margin: 0;
    color: #346947;
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .form-status[data-error="true"] {
    color: #a32626;
  }

  .form-actions {
    display: flex;
    gap: 9px;
  }

  .form-actions button {
    min-height: 41px;
    border-radius: 6px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .submit-button {
    flex: 1;
    border: 0;
    color: #fff;
    background: #891d1a;
  }

  .submit-button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .later-button {
    padding: 0 14px;
    border: 1px solid #ded9db;
    color: #51494d;
    background: #fff;
  }

  .privacy-note {
    margin: 0;
    color: #71696d;
    font-size: 0.68rem;
    line-height: 1.45;
    text-align: center;
  }

  .privacy-note a {
    color: #891d1a;
  }

  .website-field {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .newsletter-form {
      gap: 10px;
      padding: 17px 18px 15px;
    }

    .lightbox-header {
      padding: 20px 24px 16px;
    }

    .field-row {
      gap: 9px;
    }

    .newsletter-form input {
      padding-inline: 8px;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>(
    ".newsletter-lightbox",
  );
  const missionContent = document.querySelector(".mission-content");
  const newsletterForm =
    lightbox?.querySelector<HTMLFormElement>(".newsletter-form");
  const formStatus = lightbox?.querySelector<HTMLElement>(".form-status");
  const submitButton =
    lightbox?.querySelector<HTMLButtonElement>(".submit-button");
  const sessionKey = "herhaq-newsletter-lightbox-shown";

  if (
    lightbox &&
    missionContent &&
    newsletterForm &&
    formStatus &&
    submitButton
  ) {
    let alreadyShown = false;
    let openTimer: number | undefined;

    try {
      alreadyShown = sessionStorage.getItem(sessionKey) === "yes";
    } catch {
      // Continue without session persistence when browser storage is unavailable.
    }

    const missionObserver = new IntersectionObserver(
      ([entry]) => {
        if (alreadyShown) return;

        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          if (openTimer === undefined) {
            openTimer = window.setTimeout(() => {
              alreadyShown = true;
              try {
                sessionStorage.setItem(sessionKey, "yes");
              } catch {
                // The lightbox still works for this page view without storage.
              }

              lightbox.showModal();
              lightbox
                .querySelector<HTMLInputElement>('input[name="firstName"]')
                ?.focus();
              openTimer = undefined;
            }, 2500);
          }
        } else if (openTimer !== undefined) {
          window.clearTimeout(openTimer);
          openTimer = undefined;
        }
      },
      { threshold: [0, 0.5] },
    );

    missionObserver.observe(missionContent);

    const closeLightbox = () => {
      if (lightbox.open) lightbox.close();
    };

    lightbox
      .querySelector(".lightbox-close")
      ?.addEventListener("click", closeLightbox);
    lightbox
      .querySelector(".later-button")
      ?.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    newsletterForm.addEventListener("submit", (event) => {
      event.preventDefault();
      formStatus.textContent = "";
      delete formStatus.dataset.error;
      const formData = new FormData(newsletterForm);
      const values = Object.fromEntries(formData.entries());
      delete values.website;
      console.log("Newsletter signup:", values);

      formStatus.textContent =
        "Thanks! Your submission has been received.";
      newsletterForm.reset();
    });
  }
</script>
