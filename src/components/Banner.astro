---
interface Props {
  text: string;
  enabled?: boolean;
  label?: string;
}

const {
  text,
  enabled = true,
  label = "DONATE",
} = Astro.props as Props;
---

{
  enabled && (
    <div class="site-banner" id="site-banner">
      <a class="banner-inner">
        {label && <span class="banner-label">{label}</span>}
        <span class="banner-text">{text}</span>
        <span class="banner-arrow" aria-hidden="true"></span>
      </a>
    </div>
  )
}

<script>
  const banner = document.getElementById("site-banner");
  if (banner) {
    const setHeight = () => {
      document.documentElement.style.setProperty(
        "--banner-height",
        banner.offsetHeight + "px"
      );
    };
    setHeight();
    window.addEventListener("resize", setHeight);
  }
</script>

<style lang="scss" is:global>
  @import "../styles/styles.scss";

  .site-banner {
    width: 100%;
    background-color: #f5f5f5;
    text-align: center;
    padding: 7px 16px;
    z-index: 1000;
    position: fixed;
    top: 0;
    left: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-sizing: border-box;

    @include mobile {
      padding: 6px 12px;
    }
  }

  .banner-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    color: #222;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
    flex-wrap: wrap;
    text-align: center;

    @include mobile {
      font-size: 0.78rem;
      gap: 6px;
    }
  }

  .banner-label {
    display: inline-block;
    background-color: $primary;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 3px;
    flex-shrink: 0;

    @include mobile {
      font-size: 0.6rem;
      padding: 2px 6px;
    }
  }

  .banner-text {
    color: #333;

    @include mobile {
      line-height: 1.4;
    }
  }

  .banner-arrow {
    color: #333;
    font-size: 1rem;

    @include mobile {
      display: none;
    }
  }
</style>
