# Copy to .env and fill in. Nothing here is read at build time by the client
# unless the name starts with PUBLIC_ — those are bundled into the browser.
#
# docs/ARCHITECTURE.md holds the authoritative table of who reads what.

# --- Database -----------------------------------------------------------
#
# Neon Postgres. The project has two branches and you want the right one:
#
#   main  production. Real donations. Lives only in Netlify's Production
#         context -- do not put it in a local .env.
#   test  schema only, no donor rows. Use this for local dev, for the
#         reconciler, and for Netlify deploy previews.
#
# Get a string from Neon Console -> herhaq -> Branches -> pick branch ->
# Connect (pick the pooled host), or:
#
#   neonctl connection-string test --project-id rapid-river-81005603
#
# Paste the value only -- no quotes, and not the whole DATABASE_URL= line.
# Netlify stores it literally and a stray prefix gives you
# "Wrong URL scheme or missing user, host or database".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/herhaq?sslmode=require

# Reset the test branch to an empty schema whenever it gets messy:
#
#   psql "$DATABASE_URL" -f db/schema.sql

# --- Site ---------------------------------------------------------------

# Public origin, no trailing slash. Builds the Paytm callback URL and the
# post-payment redirect, so it must match where the site actually runs.
PUBLIC_SITE_URL=http://localhost:4321

# --- Paytm --------------------------------------------------------------
#
# Credentials: https://dashboard.paytm.com/ -> Developer Settings -> API Keys
# The staging values below take Paytm's test cards and move no real money.
# Production uses PAYTM_WEBSITE=DEFAULT and the secure.paytmpayments.com hosts.

PAYTM_MERCHANT_ID=your_merchant_id_here

# The one true secret in this file. Signs every checksum; never commit it.
PAYTM_MERCHANT_KEY=your_merchant_key_here

# WEBSTAGING for the test environment, DEFAULT in production.
PAYTM_WEBSITE=WEBSTAGING

PAYTM_TXN_URL=https://securegw-stage.paytm.in/theia/api/v1/initiateTransaction
PAYTM_STATUS_URL=https://securegw-stage.paytm.in/v3/order/status

# --- Reconciler (optional) ----------------------------------------------
#
# npm run reconcile -- sweeps donations stuck in INITIATED and asks Paytm
# what really happened. Point it at the test branch unless you mean it.

# How stale a donation must be before the sweep touches it. Default 15.
# RECONCILE_STALE_MINUTES=15

# Append a JSON line per reconciled donation to this path. Off by default.
# RECONCILE_AUDIT_FILE=./reconcile-audit.log
